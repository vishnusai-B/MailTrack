{
  "manifest_version": 3,
  "name": "MailTrack",
  "version": "0.1.0",
  "description": "MailTrack Chrome Extension (Manifest V3).",
  "permissions": ["storage"],
  "host_permissions": ["https://mail.google.com/*", "http://localhost:4000/*"],
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MailTrack"
  }
}
