generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TrackingStatus {
  PENDING
  DISPATCHED
  SENT
  FAILED
  EXPIRED
}

enum EventClassification {
  RECORDED
  LIKELY_PROXY
  SUSPECTED_SCANNER
}

enum CampaignStatus {
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model User {
  id                     String             @id @default(uuid())
  email                  String             @unique
  name                   String?
  passwordHash           String
  defaultTrackingEnabled Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  trackedEmails          TrackedEmail[]
  refreshTokens          RefreshToken[]
  campaigns              Campaign[]
  reminders              FollowUpReminder[]
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model TrackedEmail {
  id                 String             @id @default(uuid())
  userId             String
  campaignId         String?
  trackingTokenHash  String             @unique
  subject            String?
  recipientReference String
  status             TrackingStatus     @default(PENDING)
  sentAt             DateTime?
  expiresAt          DateTime?
  firstRecordedAt    DateTime?
  createdAt          DateTime           @default(now())

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign           Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  events             TrackingEvent[]
  reminders          FollowUpReminder[]

  @@index([userId])
  @@index([userId, sentAt(sort: Desc)])
  @@index([status, expiresAt])
  @@index([userId, campaignId])
}

model Campaign {
  id            String         @id @default(uuid())
  userId        String
  name          String
  description   String?
  status        CampaignStatus @default(ACTIVE)
  archivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedEmails TrackedEmail[]

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
}

model FollowUpReminder {
  id             String         @id @default(uuid())
  userId         String
  trackedEmailId String
  dueAt          DateTime
  note           String?
  status         ReminderStatus @default(PENDING)
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  trackedEmail   TrackedEmail   @relation(fields: [trackedEmailId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
  @@index([trackedEmailId, status])
}

model TrackingEvent {
  id             String              @id @default(uuid())
  trackedEmailId String
  eventType      String              @default("PIXEL_REQUEST")
  classification EventClassification @default(RECORDED)
  occurredAt     DateTime            @default(now())
  createdAt      DateTime            @default(now())

  trackedEmail   TrackedEmail        @relation(fields: [trackedEmailId], references: [id], onDelete: Cascade)

  @@index([trackedEmailId])
  @@index([occurredAt])
  @@index([trackedEmailId, occurredAt(sort: Asc)])
}
