# Dependencies (installed cleanly via npm ci inside the Docker builder stage)
**/node_modules

# Environment files and local secrets
**/.env
**/.env.*

# Git metadata
.git
.gitignore
.gitattributes

# Build outputs (shared and server are compiled fresh inside the builder stage;
# dashboard and extension builds are not used by the backend image)
**/dist
**/build

# Test coverage and artifacts
**/coverage
**/.nyc_output
**/*.lcov
**/.vitest

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
temp/
*.tmp

# Editor and OS metadata
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
