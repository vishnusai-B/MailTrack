# PostgreSQL connection string
DATABASE_URL="postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/mailtrack?schema=public"

# Backend Server
PORT=4000
NODE_ENV=development
TRACKING_DOMAIN="http://localhost:4000"
DASHBOARD_ORIGIN="http://localhost:5173"
EXTENSION_ORIGIN=""
JWT_ACCESS_SECRET="replace-with-32-plus-char-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_ISSUER="mailtrack-api"
JWT_AUDIENCE="mailtrack-clients"
REFRESH_TOKEN_TTL_DAYS=30
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
LOGIN_FAILED_RATE_LIMIT_MAX=10
PENDING_TTL_HOURS=24
DISPATCHED_TTL_HOURS=168
CLEANUP_INTERVAL_MS=900000

# Dashboard
VITE_API_URL="http://localhost:4000"
